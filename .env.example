# Copy this file to .env and fill in. .env is never committed.
NVIDIA_API_KEY=
# AACT (free account at https://aact.ctti-clinicaltrials.org) - used by pipelines/aact.py
AACT_USER=
AACT_PASSWORD=
# or, instead of the database: folder with the monthly pipe-delimited AACT export
# AACT_FLATFILES=/Users/you/aact_flatfiles   (if set, files are used instead of the database)
