<mxCell id="c107" value="&amp;#x27;Run this on Amazon Neptune&amp;#x27;: FastAPI → Neptune openCypher over HTTPS port&lt;br&gt;8182; if Neptune is asleep, the wake timer calls start-db-cluster&lt;br&gt;(capped)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="1268.5" width="600" height="48" as="geometry"/></mxCell>
<mxCell id="c108" value="ON DEMAND" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFF1DE;strokeColor=#C76A00;fontColor=#7A3E00;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="582.6" y="1268" width="82.4" height="18" as="geometry"/></mxCell>
<mxCell id="c109" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.5" y="1327.5" width="23.0" height="23.0" as="geometry"/></mxCell>
<mxCell id="c110" value="At boot the instance reads the NVIDIA key (encrypted) from Parameter Store&lt;br&gt;and syncs the bundle, data and index parts from Amazon S3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="1330.5" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="c111" value="BUILD TIME" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#EEF0F2;strokeColor=#687078;fontColor=#3B4148;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="575.0" y="1330" width="90.0" height="18" as="geometry"/></mxCell>
<mxCell id="c112" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="690.5" y="1111.5" width="23.0" height="23.0" as="geometry"/></mxCell>
<mxCell id="c113" value="Neptune idle stop: CloudWatch alarm → Lambda → stop; EventBridge Scheduler&lt;br&gt;30-minute sweep → Lambda; nightly stop at 23:00 IST, cron(30 17 * * ? *)&lt;br&gt;UTC → Neptune." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="722" y="1114.5" width="600" height="48" as="geometry"/></mxCell>
<mxCell id="c114" value="LIVE" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#E9F5E1;strokeColor=#1D8102;fontColor=#1D5C0C;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1270.6" y="1114" width="44.4" height="18" as="geometry"/></mxCell>
<mxCell id="c115" value="7" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="690.5" y="1173.5" width="23.0" height="23.0" as="geometry"/></mxCell>
<mxCell id="c116" value="EC2 status alarm → SNS → owner&amp;#x27;s e-mail; AWS Budgets → owner&amp;#x27;s e-mail&lt;br&gt;directly (no SNS)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="722" y="1176.5" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="c117" value="LIVE" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#E9F5E1;strokeColor=#1D8102;fontColor=#1D5C0C;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1270.6" y="1176" width="44.4" height="18" as="geometry"/></mxCell>
<mxCell id="c118" value="8" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="690.5" y="1219.5" width="23.0" height="23.0" as="geometry"/></mxCell>
<mxCell id="c119" value="Owner&amp;#x27;s Mac uploads bundle, index parts, downloads and load files to S3;&lt;br&gt;the Neptune bulk loader reads S3 through the VPC endpoint; Run Command&lt;br&gt;runs the load checks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="722" y="1222.5" width="600" height="48" as="geometry"/></mxCell>
<mxCell id="c120" value="BUILD TIME" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#EEF0F2;strokeColor=#687078;fontColor=#3B4148;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1225.0" y="1222" width="90.0" height="18" as="geometry"/></mxCell>
<mxCell id="c121" value="9" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="690.5" y="1281.5" width="23.0" height="23.0" as="geometry"/></mxCell>
<mxCell id="c122" value="Owner&amp;#x27;s Mac launches the instance with user data (EC2 API); IAM roles&lt;br&gt;grant each part only its own permissions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="722" y="1284.5" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="c123" value="BUILD TIME" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#EEF0F2;strokeColor=#687078;fontColor=#3B4148;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1225.0" y="1284" width="90.0" height="18" as="geometry"/></mxCell>
<mxCell id="c124" value="10" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="690.5" y="1327.5" width="23.0" height="23.0" as="geometry"/></mxCell>
<mxCell id="c125" value="Owner&amp;#x27;s Mac → NVIDIA GPU host (graphs in, result files out); Owner&amp;#x27;s Mac →&lt;br&gt;NIM embed, rerank and rater models." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="722" y="1330.5" width="600" height="32" as="geometry"/></mxCell>
<mxCell id="c126" value="BUILD TIME" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#EEF0F2;strokeColor=#687078;fontColor=#3B4148;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1225.0" y="1330" width="90.0" height="18" as="geometry"/></mxCell>
<mxCell id="c127" value="Badges and arrows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="1085" width="250" height="20" as="geometry"/></mxCell>
<mxCell id="c128" value="LIVE" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#E9F5E1;strokeColor=#1D8102;fontColor=#1D5C0C;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="1123" width="44.4" height="18" as="geometry"/></mxCell>
<mxCell id="c129" value="runs while the site serves&lt;br&gt;visitors" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="1144.5" width="250" height="32" as="geometry"/></mxCell>
<mxCell id="c130" value="ON DEMAND" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFF1DE;strokeColor=#C76A00;fontColor=#7A3E00;fontSize=11.5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="1195" width="82.4" height="18" as="geometry"/></mxCell>
<mxCell id="c131" value="started only when a visitor&lt;br&gt;asks; stopped when idle" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="1216.5" width="250" height="32" as="geometry"/></mxCell>
