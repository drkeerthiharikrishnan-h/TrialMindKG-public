# Copy to aws/config.env (git-ignored) and fill in. Never commit real values; keys never go in this file (they live in
# Claude Science -> Customize -> Credentials, the NVIDIA key in SSM via aws/nim_key_ssm.sh).
AWS_REGION=us-east-1                           # one region for everything
AWS_ACCOUNT_ID=123456789012                    # used to build ARNs
TMKG_BUCKET=my-trialmindkg-bucket              # S3 bucket for snapshots, graph versions, the app bundle (private)
ALERT_EMAIL=owner@example.org                  # billing alarms and budget notices go here
ALARM_USD="25 75 150"                          # CloudWatch billing alarms (aws/budget_alarms.sh)
BUDGET_USD=150                                 # monthly budget cap
APP_INSTANCE_TYPE=t3.large                     # 8 GB: one request peaks at 0.54 GB (CC-21); room for several broad questions at once
APP_DISK_GB=50                                 # card index 18.8 GB + image + logs
NEPTUNE_ENDPOINT=my-cluster.cluster-xxxx.us-east-1.neptune.amazonaws.com   # printed by aws/neptune_create.sh; the app gets it only when it is tmkg-neptune.cluster-...
NEPTUNE_LOAD_ROLE_ARN=arn:aws:iam::123456789012:role/tmkg-neptune-s3-load  # created by aws/iam_setup.sh
NEPTUNE_IAM_AUTH=0                             # 1 if the cluster uses IAM auth (needs: pip install awscurl)
NEPTUNE_WAKE_MINUTES=                          # optional: minutes the page says a wake takes (empty = "a few minutes")
NEPTUNE_ACTIVITY_METRIC=                       # idle alarm metric, empty = TotalRequestsPerSec (confirm: aws cloudwatch list-metrics --namespace AWS/Neptune)
NEPTUNE_UPTIME_METRIC=                         # idle function's "has it run the whole window" metric, empty = CPUUtilization
STOP_CRON="cron(0 4 * * ? *)"                  # 04:00 UTC = 20:00 US Pacific, 23:00 US Eastern (owner decision 14 Nov: judges work US hours)
START_CRON="cron(0 6 * * ? *)"
TMKG_TLS="${TMKG_TLS:-cloudfront}"             # front door: cloudfront, or caddy (Let's Encrypt on tmkg.<elastic-ip>.sslip.io)
TMKG_ACME_EMAIL="${TMKG_ACME_EMAIL:-}"         # caddy only, optional: ACME account e-mail (lets Caddy fall back to ZeroSSL)
NIM_BASE_URL=                                  # empty = build.nvidia.com; e.g. http://192.0.2.10:8000/v1 for a self-hosted NIM
