{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ReadAndStopTheProjectNeptune", "Effect": "Allow", "Action": ["rds:DescribeDBClusters", "rds:StopDBCluster"],
     "Resource": "arn:aws:rds:REGION:ACCOUNT_ID:cluster:tmkg-*"},
    {"Sid": "ReadTheQueryActivityMetric", "Effect": "Allow", "Action": ["cloudwatch:GetMetricStatistics"], "Resource": "*"},
    {"Sid": "WriteOwnLogGroupOnly", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
     "Resource": ["arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/tmkg-idle-stop",
                  "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/tmkg-idle-stop:*"]}
  ]
}
