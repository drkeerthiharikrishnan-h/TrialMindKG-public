#!/bin/bash
# Runs once at first boot of the app instance (rendered by aws/deploy_app.sh: BUCKET_NAME, REGION).
set -euxo pipefail
dnf install -y docker zstd
systemctl enable --now docker
# SEC-07 / SEC-08 (11 Nov): 2 GB of swap, so that a few broad questions at once slow the app down instead of getting it killed.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
# SEC-08: Docker's restart policy covers a crash, an out-of-memory kill and a reboot, but not a container whose health check
# fails (an app that is up but no longer answers). This timer looks once a minute and restarts tmkg-app when Docker reports
# it unhealthy.
mkdir -p /srv/app
cat > /srv/app/heal.sh <<'HEAL'
#!/bin/bash
state="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' tmkg-app 2>/dev/null || true)"
if [ "$state" = unhealthy ]; then
  echo "tmkg-app is unhealthy: restarting it"
  docker restart tmkg-app
fi
HEAL
chmod 700 /srv/app/heal.sh
cat > /etc/systemd/system/tmkg-heal.service <<'UNIT'
[Unit]
Description=Restart the tmkg-app container when its health check fails
After=docker.service

[Service]
Type=oneshot
ExecStart=/srv/app/heal.sh
UNIT
cat > /etc/systemd/system/tmkg-heal.timer <<'UNIT'
[Unit]
Description=Check the tmkg-app container once a minute

[Timer]
OnBootSec=3min
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now tmkg-heal.timer
# >>> PK14 A2 (host): Amazon Neptune state and wake on click; rendered only when aws/config.env names the cluster endpoint
# The container has no AWS credentials (metadata hop limit 1). This host reads the cluster state every 20 s into
# /srv/neptune/status.json and starts a stopped cluster when the app leaves /srv/neptune/wake.request. No query is sent.
mkdir -p /srv/neptune
chown 10001:10001 /srv/neptune
chmod 775 /srv/neptune
cat > /srv/app/neptune_ctl.sh <<'NEPTUNE'
#!/bin/bash
# no set -e: a failing AWS call writes the state "unknown", and the timer runs again in 20 s
DIR=/srv/neptune
LOG=/var/log/tmkg-neptune.log
state="$(aws neptune describe-db-clusters --db-cluster-identifier tmkg-neptune --region REGION \
  --query 'DBClusters[0].Status' --output text 2>/dev/null)" || state=unknown
[[ "$state" =~ ^[a-z][a-z-]*$ ]] || state=unknown
now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if tmp="$(mktemp "$DIR/.status.XXXXXX")"; then
  printf '{"state": "%s", "checked_at": "%s"}\n' "$state" "$now" > "$tmp"
  chmod 644 "$tmp"
  # rename(2) never follows a link the app might have put there, and never moves the file into a directory
  python3 -c 'import os, sys; os.replace(sys.argv[1], sys.argv[2])' "$tmp" "$DIR/status.json" 2>/dev/null || rm -f "$tmp"
fi
if [ -e "$DIR/wake.request" ] || [ -L "$DIR/wake.request" ]; then
  rm -rf "$DIR/wake.request"
  if [ "$state" != stopped ]; then
    result="no start needed (state $state)"
  elif aws neptune start-db-cluster --db-cluster-identifier tmkg-neptune --region REGION >/dev/null 2>&1; then
    result="start-db-cluster sent"
  else
    result="start-db-cluster FAILED"
  fi
  echo "$now wake request: $result" >> "$LOG"
fi
exit 0
NEPTUNE
chmod 700 /srv/app/neptune_ctl.sh
cat > /etc/systemd/system/tmkg-neptune.service <<'UNIT'
[Unit]
Description=Write the Amazon Neptune state for the app; start the cluster on a wake request
After=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/app/neptune_ctl.sh
UNIT
cat > /etc/systemd/system/tmkg-neptune.timer <<'UNIT'
[Unit]
Description=Read the Amazon Neptune state every 20 seconds

[Timer]
OnBootSec=30s
OnUnitActiveSec=20s
AccuracySec=1s

[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now tmkg-neptune.timer
# <<< PK14 A2 (host)
mkdir -p /srv/app /srv/data
aws s3 cp "s3://BUCKET_NAME/app/app-bundle.tgz" /srv/app/app-bundle.tgz --region REGION
tar -xzf /srv/app/app-bundle.tgz -C /srv/app
aws s3 sync "s3://BUCKET_NAME/app/data/" /srv/data/ --region REGION
# Downloads for judges (KGX, verdict file, Neptune files, PyG graph): served by Caddy at /downloads/ (caddy front door only).
mkdir -p /srv/downloads
aws s3 sync "s3://BUCKET_NAME/app/downloads/" /srv/downloads/ --region REGION
# Card index sent compressed (zstd) in parts under 5 GB (owner Terminal upload): app/index/parts.txt lists the parts in order.
# They are streamed through zstd -d into the path the app reads; zstd's frame checksum stops the boot on a corrupt part.
if aws s3 cp "s3://BUCKET_NAME/app/index/parts.txt" /srv/app/index_parts.txt --region REGION; then
  mkdir -p /srv/data/data/kg/pharos_index
  while read -r part; do
    aws s3 cp "s3://BUCKET_NAME/app/index/${part}" - --region REGION
  done < /srv/app/index_parts.txt | zstd -d -c > /srv/data/data/kg/pharos_index/card_index.sqlite.partial
  mv /srv/data/data/kg/pharos_index/card_index.sqlite.partial /srv/data/data/kg/pharos_index/card_index.sqlite
fi
# SEC-15: the app runs as a non-root user inside the container, so the mounted data must be readable by everyone.
chmod -R a+rX /srv/data
docker build -f /srv/app/aws/Dockerfile -t tmkg-app /srv/app
# The key never reaches the boot log or a command line (7 Nov: set -x printed it): trace off, key into a root-only env file.
set +x
umask 077
printf 'NVIDIA_API_KEY=%s\n' "$(aws ssm get-parameter --name /trialmindkg/NVIDIA_API_KEY --with-decryption --query Parameter.Value --output text --region REGION || true)" > /srv/app/nim.env
set -x
# Front door (TLS_MODE, set by deploy_app.sh from TMKG_TLS): cloudfront = the app on port 80, reachable only from CloudFront;
# caddy = the app on 127.0.0.1:8000 and Caddy in front with a free Let's Encrypt certificate for <public-ip>.sslip.io (7 Nov:
# CloudFront refused until AWS verifies the account). Caddy passes the ask box's event stream through unbuffered.
FRONT="TLS_MODE"
HOST=""
if [ "$FRONT" = caddy ]; then
  # 8 Nov: the name comes from the project's Elastic IP (deploy_app.sh renders it), so the link survives a relaunch;
  # without one, this boot's public IP is used (the link then changes with every new instance).
  HOST="PUBLIC_HOST"
  if [ -z "$HOST" ]; then
    TOKEN="$(curl -s -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
    IP="$(curl -s -H "X-aws-ec2-metadata-token: ${TOKEN}" http://169.254.169.254/latest/meta-data/public-ipv4)"
    HOST="tmkg.${IP//./-}.sslip.io"
  fi
  APP_PORT="127.0.0.1:8000:8000"
else
  APP_PORT="80:8000"
fi
DL_ENV=()
if [ -n "$HOST" ] && [ -d /srv/downloads ] && [ -n "$(ls -A /srv/downloads)" ]; then
  DL_ENV=(-e "TMKG_DOWNLOADS_BASE=https://${HOST}/downloads/")
fi
# >>> PK14 A2 (app): the app learns where Amazon Neptune is and reads its state; rendered only with the cluster endpoint
# (no TMKG_GRAPH_BACKEND: the local index stays the default answer path, owner decision 14 Nov)
NHOST="NEPTUNE_HOST"
NWAKE="NEPTUNE_WAKE_MIN"
if [ -n "$NHOST" ]; then
  DL_ENV+=(-e "NEPTUNE_ENDPOINT=${NHOST}" -e NEPTUNE_STATUS_DIR=/neptune -v /srv/neptune:/neptune)
  if [ -n "$NWAKE" ]; then DL_ENV+=(-e "NEPTUNE_WAKE_MINUTES=${NWAKE}"); fi
fi
# <<< PK14 A2 (app)
docker rm -f tmkg-app 2>/dev/null || true
# SEC-08: container logs are capped (3 files of 20 MB), so they cannot fill the disk.
docker run -d --name tmkg-app --restart unless-stopped --log-opt max-size=20m --log-opt max-file=3 \
  -p "$APP_PORT" -v /srv/data:/data:ro \
  --env-file /srv/app/nim.env "${DL_ENV[@]+"${DL_ENV[@]}"}" tmkg-app
if [ "$FRONT" = caddy ]; then
  mkdir -p /srv/caddy /srv/downloads
  # 9 Nov (CC-42): Let's Encrypt issues 5 certificates per hostname per 7 days, and /srv/caddy (certificate + ACME
  # account) used to die with the instance, so every relaunch asked for a new one. Restore it from S3 before Caddy
  # starts; a missing prefix (first boot) or a role without the app/caddy/ grant only means a fresh certificate.
  aws s3 sync "s3://BUCKET_NAME/app/caddy/" /srv/caddy/ --region REGION --only-show-errors \
    || echo "WARNING: no saved Caddy certificate restored (first boot, or the role lacks s3 on app/caddy/*)"
  # Optional ACME e-mail (TMKG_ACME_EMAIL in aws/config.env): with it Caddy can fall back to ZeroSSL.
  ACME_MAIL="ACME_EMAIL"
  # >>> PK14 A1b: behind Amazon CloudFront, Caddy's peer is an edge address, so the app's per-address fallback would put
  # visitors without a cookie together. Trust X-Forwarded-For only from CloudFront's origin-facing ranges (read at boot from
  # ip-ranges.amazonaws.com; strict = right to left, so a value a viewer sends is never taken) and hand the app exactly one
  # address. A direct request to the sslip.io name comes from an untrusted peer: its own address is used, as before.
  CF_PROXIES=""
  XFF_ONE_ADDRESS=""
  # (piped, not stored: the boot trace must not print the whole file)
  if CF_PROXIES="$(curl -fsS --max-time 20 https://ip-ranges.amazonaws.com/ip-ranges.json | python3 -c '
import ipaddress, json, sys
d = json.load(sys.stdin)
p = [x["ip_prefix"] for x in d.get("prefixes", []) if x.get("service") == "CLOUDFRONT_ORIGIN_FACING"]
p += [x["ipv6_prefix"] for x in d.get("ipv6_prefixes", []) if x.get("service") == "CLOUDFRONT_ORIGIN_FACING"]
print(" ".join(sorted({str(ipaddress.ip_network(x)) for x in p})))')" && [ -n "$CF_PROXIES" ]; then
    echo "Caddy trusts X-Forwarded-For from $(( $(wc -w <<< "$CF_PROXIES") )) CloudFront origin-facing ranges"
    XFF_ONE_ADDRESS=1
  else
    CF_PROXIES=""
    echo "WARNING: CloudFront origin-facing ranges not read; no trusted proxies (visitors through CloudFront share one address)"
  fi
  # <<< PK14 A1b
  : > /srv/app/Caddyfile
  if [ -n "$ACME_MAIL" ] || [ -n "$CF_PROXIES" ]; then
    {
      printf '{\n'
      if [ -n "$ACME_MAIL" ]; then printf '  email %s\n' "$ACME_MAIL"; fi
      if [ -n "$CF_PROXIES" ]; then printf '  servers {\n    trusted_proxies static %s\n    trusted_proxies_strict\n  }\n' "$CF_PROXIES"; fi
      printf '}\n\n'
    } > /srv/app/Caddyfile
  fi
  # SEC-05 / SEC-06 (11 Nov): compressed answers (not the ask box's event stream, which must arrive unbuffered), security
  # headers on everything Caddy serves (a header the app or the downloads listing already set is kept: the "?" form only
  # fills a missing one), and a size limit on request bodies (1 MB for the two endpoints that take an answer back, 256 KB
  # for the rest; the app enforces the same limits itself).
  cat >> /srv/app/Caddyfile <<CADDY
${HOST} {
  @compressible not path /api/ask_stream
  encode @compressible zstd gzip
  header {
    ?Strict-Transport-Security "max-age=31536000"
    ?X-Content-Type-Options "nosniff"
    ?X-Frame-Options "DENY"
    ?Referrer-Policy "strict-origin-when-cross-origin"
    ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    ?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  }
  @answers path /api/summarize /api/pharos/subgraph.zip
  request_body @answers {
    max_size 1MB
  }
  @requests not path /api/summarize /api/pharos/subgraph.zip
  request_body @requests {
    max_size 256KB
  }
  handle /downloads/* {
    root * /srv
    file_server browse
  }
  handle {
    reverse_proxy 127.0.0.1:8000
  }
}
CADDY
  # >>> PK14 A1b (upstream): with trusted proxies, the app gets exactly one address, Caddy's {client_ip}
  if [ -n "$XFF_ONE_ADDRESS" ]; then
    awk '$0 == "    reverse_proxy 127.0.0.1:8000" { print $0 " {"; print "      header_up X-Forwarded-For {client_ip}"; print "    }"; next }
         { print }' /srv/app/Caddyfile > /srv/app/Caddyfile.new
    mv -f /srv/app/Caddyfile.new /srv/app/Caddyfile
  fi
  # <<< PK14 A1b (upstream)
  docker rm -f caddy 2>/dev/null || true
  # the Caddy image is pinned by digest (the multi-platform index of caddy:2, read from Docker Hub on 2026-11-11; SEC-15)
  docker run -d --name caddy --restart unless-stopped --log-opt max-size=20m --log-opt max-file=3 --network host \
    -v /srv/caddy:/data \
    -v /srv/app/Caddyfile:/etc/caddy/Caddyfile:ro -v /srv/downloads:/srv/downloads:ro \
    caddy:2@sha256:ce773ec7a742ce15ee6bf2bb5f65882b9e2a4487b10733e6f1484f86e6b5d8bc
  # Save /srv/caddy back to S3: every 10 minutes (picks up the certificate once issued, and renewals) and at shutdown
  # (systemd runs ExecStop before the network goes down). Lock files are per-instance and are not saved.
  cat > /srv/app/caddy_sync.sh <<'SYNC'
#!/bin/bash
exec aws s3 sync /srv/caddy/ "s3://BUCKET_NAME/app/caddy/" --region REGION --only-show-errors --exclude "caddy/locks/*"
SYNC
  chmod 700 /srv/app/caddy_sync.sh
  UNIT_DIR=/etc/systemd/system
  cat > "$UNIT_DIR/tmkg-caddy-sync.service" <<UNIT
[Unit]
Description=Save Caddy's certificate (/srv/caddy) to S3; also runs at shutdown
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/srv/app/caddy_sync.sh
ExecStop=/srv/app/caddy_sync.sh

[Install]
WantedBy=multi-user.target
UNIT
  cat > "$UNIT_DIR/tmkg-caddy-sync-periodic.service" <<UNIT
[Unit]
Description=Save Caddy's certificate (/srv/caddy) to S3 (periodic)

[Service]
Type=oneshot
ExecStart=/srv/app/caddy_sync.sh
UNIT
  cat > "$UNIT_DIR/tmkg-caddy-sync-periodic.timer" <<UNIT
[Unit]
Description=Save Caddy's certificate to S3 every 10 minutes

[Timer]
OnActiveSec=2min
OnUnitActiveSec=10min

[Install]
WantedBy=timers.target
UNIT
  systemctl daemon-reload
  systemctl enable --now tmkg-caddy-sync.service tmkg-caddy-sync-periodic.timer
  echo "HOSTED_URL https://${HOST}/" | tee /srv/app/hosted_url.txt
fi
