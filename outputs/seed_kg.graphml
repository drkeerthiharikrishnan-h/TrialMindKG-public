      <data key="d0">tmkg:StudyArm</data>
      <data key="d1">Tiragolumab + Atezolizumab</data>
      <data key="d10">EXPERIMENTAL</data>
      <data key="d11">Participants will receive atezolizumab followed by tiragolumab every 3 weeks (Q3W) on Day 1 of each 21-day cycle until disease progression, loss of clinical benefit or unacceptable toxicity.</data>
      <data key="d9">biolink:Cohort</data>
    </node>
