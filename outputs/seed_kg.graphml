: null, "group": "BG002", "spread": null, "value": "0"}, {"category": "Black or African American", "cls": null, "group": "BG003", "spread": null, "value": "2"}, {"category": "White", "cls": null, "group": "BG000", "spread": null, "value": "91"}, {"category": "White", "cls": null, "group": "BG001", "spread": null, "value": "83"}, {"category": "White", "cls": null, "group": "BG002", "spread": null, "value": "89"}, {"category": "White", "cls": null, "group": "BG003", "spread": null, "value": "263"}, {"category": "Unknown", "cls": null, "group": "BG000", "spread": null, "value": "13"}, {"category": "Unknown", "cls": null, "group": "BG001", "spread": null, "value": "20"}, {"category": "Unknown", "cls": null, "group": "BG002", "spread": null, "value": "17"}, {"category": "Unknown", "cls": null, "group": "BG003", "spread": null, "value": "50"}]}]</data>
