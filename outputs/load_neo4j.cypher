// TrialMindKG - Neo4j Desktop import. GENERATED by pipelines/export.py from kg_schema.py; do not edit.
// Copy outputs/kg_nodes.csv + kg_edges.csv into the DBMS 'import' folder, then run this script.
CREATE CONSTRAINT entity_id IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;

LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:BiologicalProcess'
MERGE (n:Entity {id: row.id}) SET n:BiologicalProcess, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:ClinicalTrial'
MERGE (n:Entity {id: row.id}) SET n:ClinicalTrial, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:Disease'
MERGE (n:Entity {id: row.id}) SET n:Disease, n += row;
