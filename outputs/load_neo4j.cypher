LOAD CSV WITH HEADERS FROM 'file:///kg_edges.csv' AS row WITH row WHERE row.predicate = 'biolink:associated_with'
MATCH (a:Entity {id: row.subject}), (b:Entity {id: row.object})
MERGE (a)-[r:ASSOCIATED_WITH {id: row.id}]->(b) SET r += row;
