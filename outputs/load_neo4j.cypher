// ---- Example questions ----
// Which failed programs share a drug target?
MATCH (p1:ClinicalTrialProgram)-[:HAS_INTERVENTION]->(:Drug)-[:INTERACTS_WITH]->(t)<-[:INTERACTS_WITH]-(:Drug)<-[:HAS_INTERVENTION]-(p2:ClinicalTrialProgram)
WHERE p1.id < p2.id RETURN t.name AS target, collect(DISTINCT p1.name + '  |  ' + p2.name) AS program_pairs;
// Primary outcomes of TULIP-1 with their statistical analyses
MATCH (:ClinicalTrial {id:'NCT:NCT02446912'})-[:HAS_OUTCOME_MEASURE]->(o) WHERE o.kind = 'PRIMARY' RETURN o.name, o.analyses;
