MERGE (n:Entity {id: row.id}) SET n:Drug, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:Gene'
MERGE (n:Entity {id: row.id}) SET n:Gene, n += row;
