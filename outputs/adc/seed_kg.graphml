    <node id="LIT1">
      <data key="d0">tmkg:LiteratureFinding</data>
      <data key="d1">external</data>
      <data key="d2">UPLIFT: investigator ORR 15.6% (95% CI 10.0-22.7%) in NaPi2b-positive (TPS&gt;=75%, n=141); lower CI bound did not exclude the 12% ORR of single-agent chemotherapy.</data>
      <data key="d10">efficacy_failure</data>
      <data key="d11">https://www.targetedonc.com/view/upifitamab-rilsodotin-misses-primary-end-point-in-ovarian-cancer</data>
      <data key="d3">biolink:InformationContentEntity</data>
    </node>
    <node id="LIT2">
      <data key="d0">tmkg:LiteratureFinding</data>
      <data key="d1">external</data>
      <data key="d2">UPLIFT efficacy failed to replicate the ~100-patient phase 1b dose-expansion data (sponsor statement).</data>
      <data key="d10">replication_failure</data>
      <data key="d11">https://www.onclive.com/view/upifitamab-rilsodotin-fails-to-meet-orr-end-point-in-napi2b-platinum-resistant-ovarian-cancer</data>
      <data key="d3">biolink:InformationContentEntity</data>
    </node>
    <node id="LIT3">
      <data key="d0">tmkg:LiteratureFinding</data>
      <data key="d1">external</data>
      <data key="d2">UPLIFT overall ORR 13.1%; no indication that NaPi2b positivity (TPS&gt;=75%) enriched for response.</data>
      <data key="d10">biomarker_non_enrichment</data>
      <data key="d11">https://www.onclive.com/view/dr-richardson-on-the-uplift-trial-of-upifitamab-rilsodotin-in-ovarian-cancer</data>
      <data key="d3">biolink:InformationContentEntity</data>
    </node>
    <node id="LIT4">
      <data key="d0">tmkg:LiteratureFinding</data>
      <data key="d1">external</data>
      <data key="d2">UPLIFT population: median 3 prior lines (31% had 4), 69% prior PARP inhibitor, 84% prior bevacizumab.</data>
      <data key="d10">population</data>
      <data key="d11">https://www.cancernetwork.com/view/upifitamab-rilsodotin-does-not-improve-responses-in-ovarian-cancer</data>
      <data key="d3">biolink:InformationContentEntity</data>
    </node>
    <node id="LIT5">
      <data key="d0">tmkg:LiteratureFinding</data>
      <data key="d1">external</data>
      <data key="d2">Upifitamab rilsodotin was placed on partial clinical hold over risk of bleeding events.</data>
      <data key="d10">safety_hold</data>
      <data key="d11">https://www.oncologypipeline.com/apexonco/mersanas-discontinuation-was-long-time-coming</data>
      <data key="d3">biolink:InformationContentEntity</data>
    </node>
    <node id="LIT6">
      <data key="d0">tmkg:LiteratureFinding</data>
      <data key="d1">external</data>
      <data key="d2">TUB-040 phase 1 (ESMO): confirmed ORR 50%, unconfirmed 60% across dose levels, irrespective of target antigen expression.</data>
      <data key="d10">early_efficacy</data>
      <data key="d11">https://oncodaily.com/technology/tubulis481541</data>
      <data key="d3">biolink:InformationContentEntity</data>
    </node>
    <node id="LIT7">
      <data key="d0">tmkg:LiteratureFinding</data>
      <data key="d1">external</data>
      <data key="d2">TUB-040: NaPi2b-directed ADC carrying eight topoisomerase-I inhibitor payloads on a stable, cleavable linker (Tubutecan).</data>
      <data key="d10">design</data>
      <data key="d11">https://investors.gilead.com/news/news-details/2026/Gilead-Sciences-Completes-Acquisition-of-Tubulis-Further-Strengthening-Oncology-Portfolio/default.aspx</data>
      <data key="d3">biolink:InformationContentEntity</data>
    </node>
    <node id="LIT8">
      <data key="d0">tmkg:LiteratureFinding</data>
      <data key="d1">external</data>
      <data key="d2">ASCENT-07: TOP1-inhibitor ADC moved to first chemotherapy line in HR+/HER2- mBC did not meet PFS (median 8.3 vs 8.3 months).</data>
      <data key="d10">earlier_line_failure</data>
      <data key="d11">https://www.oncologynewscentral.com/breast-cancer/phase-3-failure-for-sacituzumab-govitecan-in-hr-positive-her2-negative-advanced-breast-cancer</data>
      <data key="d3">biolink:InformationContentEntity</data>
    </node>
