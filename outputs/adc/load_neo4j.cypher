// TrialMindKG - Neo4j Desktop import. GENERATED by pipelines/export.py from kg_schema.py; do not edit.
// Copy outputs/kg_nodes.csv + kg_edges.csv into the DBMS 'import' folder, then run this script.
CREATE CONSTRAINT entity_id IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;

LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:AnatomicalEntity'
MERGE (n:Entity {id: row.id}) SET n:AnatomicalEntity, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:ClinicalTrial'
MERGE (n:Entity {id: row.id}) SET n:ClinicalTrial, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:Disease'
MERGE (n:Entity {id: row.id}) SET n:Disease, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:Drug'
MERGE (n:Entity {id: row.id}) SET n:Drug, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:PhenotypicFeature'
MERGE (n:Entity {id: row.id}) SET n:PhenotypicFeature, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'biolink:Protein'
MERGE (n:Entity {id: row.id}) SET n:Protein, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'tmkg:BiomarkerDefinition'
MERGE (n:Entity {id: row.id}) SET n:BiomarkerDefinition:InformationContentEntity, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'tmkg:BiomarkerStratum'
MERGE (n:Entity {id: row.id}) SET n:BiomarkerStratum:Cohort, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'tmkg:InternalStudy'
MERGE (n:Entity {id: row.id}) SET n:InternalStudy:Study, n += row;
LOAD CSV WITH HEADERS FROM 'file:///kg_nodes.csv' AS row WITH row WHERE row.category = 'tmkg:LiteratureFinding'
MERGE (n:Entity {id: row.id}) SET n:LiteratureFinding:InformationContentEntity, n += row;

LOAD CSV WITH HEADERS FROM 'file:///kg_edges.csv' AS row WITH row WHERE row.predicate = 'biolink:expressed_in'
MATCH (a:Entity {id: row.subject}), (b:Entity {id: row.object})
MERGE (a)-[r:EXPRESSED_IN {id: row.id}]->(b) SET r += row;
