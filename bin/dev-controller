#!/usr/bin/env python3
"""Run a persistent development task in this checkout."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from harness.dev_controller import Controller, ControllerError, strict_load

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    init = sub.add_parser('init'); init.add_argument('manifest')
    for name in ('run', 'resume', 'request', 'pause', 'cancel'):
        p = sub.add_parser(name); p.add_argument('id')
    status = sub.add_parser('status'); status.add_argument('id', nargs='?')
    submit = sub.add_parser('submit'); submit.add_argument('id'); submit.add_argument('response')
    sub.add_parser('doctor')
    args = parser.parse_args(); c = Controller(ROOT)
    try:
        if args.command == 'init': print(c.init(strict_load(Path(args.manifest).read_text()))); return 0
        if args.command == 'status': result = c.status(args.id)
        elif args.command == 'run': result = c.execute(args.id)
        elif args.command == 'resume': c.control(args.id, 'resume'); result = c.execute(args.id)
        elif args.command in ('pause', 'cancel'): result = c.control(args.id, args.command)
        elif args.command == 'request': result = c.request(args.id)
        elif args.command == 'submit': result = c.submit(args.id, strict_load(Path(args.response).read_text()))
        else:
            import shutil
            result = {'codex': shutil.which('codex'), 'sandbox_exec': str(Path('/usr/bin/sandbox-exec')) if Path('/usr/bin/sandbox-exec').exists() else None, 'platform': sys.platform}
        if args.command in ('run', 'resume'):
            result = c.display_status(result)
            status = result['status']
        print(json.dumps(result, indent=2, sort_keys=True))
        if args.command in ('run', 'resume'):
            return {'ACCEPTED': 0, 'WAITING': 3, 'PAUSED': 3, 'BLOCKED': 2, 'NEEDS_ATTENTION': 2, 'CANCELLED': 4}.get(status, 2)
        return 0
    except (ControllerError, ValueError, OSError, KeyError) as exc:
        print(str(exc), file=sys.stderr); return 1
if __name__ == '__main__': sys.exit(main())
