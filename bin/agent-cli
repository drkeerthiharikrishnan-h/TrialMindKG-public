def build_parser():
    ap = argparse.ArgumentParser(prog="agent-cli", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true", help="print JSON instead of tab lines")
    sp = ap.add_subparsers(dest="cmd", required=True)
    sp.add_parser("controller", help="persistent autonomous development controller (run, resume, status)")

    p = sp.add_parser("start", help="session start: branch vs origin/main, dirty files, open steps, last log entry, env")
    p.add_argument("--fetch", action="store_true", help="git fetch origin main first")
    p = sp.add_parser("git", help="branch, HEAD, origin/main, ahead/behind, dirty files")
    p.add_argument("--fetch", action="store_true")
    sp.add_parser("branches", help="remote branches and whether main already contains them (delete command)")
    p = sp.add_parser("next", help="open [ ]/[~] items of docs/NEXT_STEPS.md; --step 7e prints one step in full")
    p.add_argument("--all", action="store_true", help="include done items")
    p.add_argument("--step", help="print the full block of this step id")
    p.add_argument("-n", type=int, default=50)
    p = sp.add_parser("status", help="latest session-log entries (archived docs/archive/STATUS_CHECKLIST.md)")
    p.add_argument("-n", type=int, default=3)
    p.add_argument("--full", action="store_true", help="whole entry text, not the first 200 chars")
    p = sp.add_parser("rules", help="grep the rule/memory docs (CLAUDE.md, SKILL.md, PROJECT_MEMORY, plans)")
    p.add_argument("term")
    p = sp.add_parser("defs", help="functions/classes of a file with line numbers and docstring first line")
    p.add_argument("file")
    p = sp.add_parser("fn", help="source of one function/class, numbered")
    p.add_argument("file")
    p.add_argument("name")
    p = sp.add_parser("show", help="lines START-END of a file, numbered")
    p.add_argument("file")
    p.add_argument("start", type=int)
    p.add_argument("end", type=int)
    p = sp.add_parser("section", help="a markdown section by heading regex")
    p.add_argument("file")
    p.add_argument("heading")
    p = sp.add_parser("grep", help="grep -n a regex across code/docs/sources (data, outputs, raw excluded)")
    p.add_argument("term")
    p.add_argument("paths", nargs="*")
    p.add_argument("-i", action="store_true")
    p = sp.add_parser("find", help="files whose name contains a fragment")
    p.add_argument("name")
    p = sp.add_parser("map", help="files of a directory with their first docstring/comment line")
    p.add_argument("dir", nargs="?", default="pipelines")
    p = sp.add_parser("card", help="source card summary: name, layer, lookups, node/edge blocks")
    p.add_argument("name", help="card stem (pharos) or path")
    p.add_argument("--raw", action="store_true", help="print the yaml itself")
    p = sp.add_parser("nim-check", help="pre-flight: every model id of config/nim_models.yaml answers one tiny structured call "
                                       "(live catalogue listing, 404-for-this-account); exit 1 if one fails, 2 without a key")
    p.add_argument("--no-list", action="store_true", help="skip reading the live model list")
    sp.add_parser("layers", help="per source card: layer built? verdicts? prune share? summary?")
    sp.add_parser("graphs", help="G0-G4: heterodata.pt present and summary totals")
    p = sp.add_parser("results", help="linkpred result JSONs: AUROC per graph/task/split with baselines and wiring")
    p.add_argument("--dir", default="outputs/linkpred")
    p = sp.add_parser("tsv", help="columns, first rows and row count of a tsv(.gz)")
    p.add_argument("file")
    p.add_argument("-n", type=int, default=5)
    p = sp.add_parser("test", help="pytest: paths, --for MODULE (its test files), --bg (background), --last (log tail)")
    p.add_argument("paths", nargs="*")
    p.add_argument("--for", dest="module", help="run the test files that match this source file")
    p.add_argument("--bg", action="store_true")
    p.add_argument("--last", action="store_true")
    p.add_argument("--only-list", action="store_true", help="list the matching test files, do not run")
    p = sp.add_parser("wait", help="poll until a log contains a string or a PID exits (no foreground sleep needed)")
    p.add_argument("--log")
    p.add_argument("--until")
    p.add_argument("--pid", type=int)
    p.add_argument("--every", type=int, default=10)
    p.add_argument("--max", type=int, default=590)
    sp.add_parser("jobs", help="background python jobs of this repo (pid, elapsed, command); kill by PID, never pkill -f")
    p = sp.add_parser("kill", help="kill a job by PID")
    p.add_argument("pid", type=int)
    p = sp.add_parser("app", help="start|stop|status|log the FastAPI app in the background")
    p.add_argument("action", choices=["start", "stop", "status", "log"])
    p.add_argument("--pharos-root", help="TMKG_PHAROS_ROOT for a fixture graph")
    p.add_argument("--port", type=int, default=8000)
    p = sp.add_parser("commit", help="git add PATHS + commit with the mandatory trailers (session URL from --session or $CLAUDE_SESSION_URL)")
    p.add_argument("-m", required=True)
    p.add_argument("paths", nargs="*")
    p.add_argument("--session", default=os.environ.get("CLAUDE_SESSION_URL", ""))
    p.add_argument("--dry", action="store_true")
    p = sp.add_parser("sync", help="session end: push the session branch, fast-forward main (prints commands; --run executes)")
    p.add_argument("--run", action="store_true")
    p = sp.add_parser("mac", help="the owner's terminal block in the standard shape (cd, venv, pull, commands)")
    p.add_argument("commands", nargs="+")
    p.add_argument("--no-pull", action="store_true")
    p.add_argument("--paste", default="the last 3 lines")
    p = sp.add_parser("env", help="python, where (mac/cloud), imports that load, graphs/layers on disk, blocked hosts")
    p = sp.add_parser("handoff", help="show docs/HANDOFF.md (the previous session's snapshot); --write regenerates it from live state")
    p.add_argument("--write", action="store_true")
    p = sp.add_parser("transcript", help="condensed view of a transcript .jsonl: user messages, replies, tool calls, one line each")
    p.add_argument("path", nargs="?", help="default: this repo's newest transcript under ~/.claude/projects")
    p.add_argument("--last", type=int, default=80)
    p.add_argument("--width", type=int, default=220)
    p.add_argument("--grep", help="only rows matching this regex")
    p = sp.add_parser("digest", help="session digest markdown (owner messages, commits, files) from a transcript; --write saves it under docs/sessions/")
    p.add_argument("path", nargs="?")
    p.add_argument("--write", action="store_true")
    sp.add_parser("continuity", help="check .claude/continuity.yaml: every file it names exists; print the start/end sequences")
    p = sp.add_parser("end", help="session end: write HANDOFF.md + digest, commit them, push branch, fast-forward main (--run executes)")
    p.add_argument("-m", default="handoff: session snapshot and digest")
    p.add_argument("--session", default=os.environ.get("CLAUDE_SESSION_URL", ""))
    p.add_argument("--run", action="store_true")
    p.add_argument("--transcript", help="transcript .jsonl for the digest (default: newest)")
    p.add_argument("--digest", action="store_true", help="also write docs/sessions/<date>_<id>.md from the transcript (opt-in: it quotes the conversation)")
    p = sp.add_parser("repeats", help="audit session transcripts: repeated calls per category and bytes read (the before table)")
    p.add_argument("jsonl", nargs="*", help="transcript files (default: this repo's under ~/.claude/projects)")
    return ap


def nim_check(list_models=True, as_json=False):
    """The pre-flight of pipelines/nim.py. Returns (report or lines, exit code): 0 all models answer, 1 a model failed,
    2 no key (offline backend: nothing hosted to check), 3 packages missing (use the venv python)."""
    sys.path.insert(0, str(ROOT / "pipelines"))
    try:
        import nim as nimmod
    except ImportError as err:               # requests / yaml live in the project venv, not in a bare python3
        return [f"nim-check needs the project environment ({err}): .venv/bin/python bin/agent-cli nim-check"], 3
    rep = nimmod.preflight(nimmod.NIM(), list_models=list_models)
    out = rep if as_json else nimmod.preflight_text(rep).splitlines()
    return out, (2 if rep["ok"] is None else 0 if rep["ok"] else 1)


def main(argv=None):
    try:                                     # `agent-cli ... | head` must not end in a BrokenPipe traceback
        import signal
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (ImportError, AttributeError, ValueError):
        pass
    ap = build_parser()
    argv = list(sys.argv[1:] if argv is None else argv)
    as_json = "--json" in argv            # accepted before or after the subcommand
    argv = [x for x in argv if x != "--json"]
    if argv and argv[0] == "controller":
        # Forward argv without a shell; the controller owns its schema and exit codes.
        result = subprocess.run([sys.executable, str(ROOT / "bin" / "dev-controller"), *argv[1:]], cwd=ROOT)
        raise SystemExit(result.returncode)
    a = ap.parse_args(argv)
    a.json = as_json
    c = a.cmd
    if c == "start":
        out = start(a.fetch)
    elif c == "git":
        out = git_state(a.fetch)
    elif c == "branches":
        out = branches()
    elif c == "next":
        text = read("docs/NEXT_STEPS.md")
        out = step_text(text, a.step) if a.step else [f"{i['id']}\t{i['state']}\t{i['who']}\t{i['text'][:400]}" for i in next_items(text, not a.all)[:a.n]]
        if a.json and not a.step:
            out = next_items(text, not a.all)[:a.n]
    elif c == "status":
        ents = status_entries(read(STATUS_LOG))[:a.n]
        out = ents if a.json else [f"{e['date']}\t{e['head']}\t{e['text'] if a.full else e['text'][:200]}" for e in ents]
    elif c == "rules":
        out = rules(a.term)
    elif c == "defs":
        out = defs(a.file)
    elif c == "fn":
        out = fn_source(a.file, a.name) or f"no def/class named {a.name} in {a.file}"
    elif c == "show":
        out = [f"{a.start + i}\t{l}" for i, l in enumerate(file_lines(a.file, a.start, a.end))]
    elif c == "section":
        out = section(a.file, a.heading) or [f"no heading matching {a.heading!r} in {a.file}"]
    elif c == "grep":
        out = grep(a.term, a.paths or None, a.i)
    elif c == "find":
        out = find_files(a.name)
    elif c == "map":
        out = repo_map(a.dir)
    elif c == "card":
        rel = a.name if a.name.endswith(".yaml") else f"sources/{a.name}.yaml"
        out = read(rel) if a.raw else card_summary(rel)
    elif c == "nim-check":
        out, code = nim_check(not a.no_list, as_json)
        if code:
            emit(out, as_json)
            raise SystemExit(code)
    elif c == "layers":
        out = layers()
    elif c == "graphs":
        out = graphs()
    elif c == "results":
        out = results(a.dir) or [{"note": f"no result JSON in {a.dir}"}]
    elif c == "tsv":
        out = tsv_head(a.file, a.n)
    elif c == "test":
        if a.last:
            out = last_test_log()
        else:
            paths = list(a.paths) + (test_for(a.module) if a.module else [])
            if a.module and not test_for(a.module):
                out = {"error": f"no test file for {a.module}; CLAUDE.md rule 8: write tests/test_{Path(a.module).stem}.py"}
            elif a.only_list:
                out = paths
            else:
                out = run_tests(paths, a.bg)
    elif c == "wait":
        out = wait_for(a.log, a.until, a.pid, a.every, a.max)
    elif c == "jobs":
        out = jobs()
    elif c == "kill":
        rc, o = sh(f"kill {a.pid}")
        out = {"pid": a.pid, "killed": rc == 0, "msg": o}
    elif c == "app":
        out = app(a.action, a.port, a.pharos_root)
    elif c == "commit":
        out = do_commit(a.m, a.paths, a.session, a.dry)
    elif c == "sync":
        out = sync(a.run)
    elif c == "mac":
        out = mac_block(a.commands, not a.no_pull, a.paste)
    elif c == "env":
        out = env_report()
    elif c == "handoff":
        if a.write:
            (ROOT / HANDOFF).write_text(handoff_markdown(handoff_state()))
        out = read(str(HANDOFF)) or f"no {HANDOFF} yet; write it with: bin/agent-cli handoff --write"
    elif c == "transcript":
        files = [a.path] if a.path else default_transcripts()
        if not files:
            raise SystemExit("no transcript found; pass a path")
        latest = max(files, key=lambda f: Path(f).stat().st_mtime)
        rows = transcript_rows(latest, a.width)
        if a.grep:
            rows = [r for r in rows if re.search(a.grep, r["text"], re.I)]
        rows = rows[-a.last:]
        out = rows if a.json else [f"{latest}\t{len(rows)} rows shown"] + [f"{r['n']}\t{r['who']}\t{r['text']}" for r in rows]
    elif c == "digest":
        files = [a.path] if a.path else default_transcripts()
        if not files:
            raise SystemExit("no transcript found; pass a path")
        latest = max(files, key=lambda f: Path(f).stat().st_mtime)
        text = session_digest(latest)
        if a.write:
            (ROOT / SESSIONS_DIR).mkdir(exist_ok=True)
            target = ROOT / SESSIONS_DIR / f"{time.strftime('%Y-%m-%d', time.gmtime())}_{Path(latest).stem[:8]}.md"
            target.write_text(text)
            out = {"written": str(target.relative_to(ROOT))}
        else:
            out = text
    elif c == "continuity":
        out = continuity_check()
    elif c == "end":
        out = end_session(a.m, a.session, a.run, a.transcript, a.digest)
    elif c == "repeats":
        files = a.jsonl or default_transcripts()
        if not files:
            raise SystemExit("no transcript .jsonl found; pass paths")
        out = repeats(files)
        if not a.json:
            print(f"transcripts\t{len(files)}\ttool_calls\t{out['tool_calls']}")
            out = out["rows"]
    else:
        ap.error(c)
    emit(out, a.json)


if __name__ == "__main__":
    main()
